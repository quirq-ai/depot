#!/usr/bin/env python3
"""A fake `qqgate` for tests: the required/verdict JSON contract of quirq-ai/gate (V0-GAT-01).

Repos in $FAKE_GATE_REPOS are gated by $FAKE_GATE_REQUIRED; checks come from the fake gh state.
"""
import json
import os
import sys

args = sys.argv[1:]
repo = args[args.index("--repo") + 1]
if os.environ.get("FAKE_GATE_CRASH"):   # a failure whose text happens to name the ungated case
    print(f"qqgate: internal error: {repo!r} is not an onboarded repo, or so the traceback says", file=sys.stderr)
    sys.exit(2)
if repo not in os.environ["FAKE_GATE_REPOS"].split(","):   # gate #7: exit 3 and a structured answer
    print(json.dumps({"repo": repo, "onboarded": False}, indent=2))
    print(f"qqgate: {repo!r} is not an onboarded repo in infra-config repos.toml", file=sys.stderr)
    sys.exit(3)
required = os.environ["FAKE_GATE_REQUIRED"].split(",")
if args[0] == "required":
    print(json.dumps({"repo": repo, "backend": "github", "merge_method": "squash",
                      "required": [{"name": n} for n in required]}))
    sys.exit(0)
sha = args[args.index("--sha") + 1]
with open(os.environ["FAKE_GH_STATE"]) as f:
    state = json.load(f)
observed = state["checks"].get(sha, {})
missing = [n for n in required if n not in observed]
failing = [{"name": n, "state": observed[n]} for n in required if n in observed and observed[n] != "success"]
green = [n for n in required if observed.get(n) == "success"]
passed = not missing and not failing
with open(os.environ["FAKE_GH_STATE"] + ".gate-token", "w") as f:
    f.write(os.environ.get("QQ_GITHUB_TOKEN", ""))
print(json.dumps({"repo": repo, "verdict": "pass" if passed else "refused",
                  "missing": missing, "failing": failing, "green": green}))
sys.exit(0 if passed else 1)
